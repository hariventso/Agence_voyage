<div style="margin:0;padding:0;background:#f1f5f9;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;color:#0f172a;">
  <div style="max-width:620px;margin:0 auto;padding:40px 16px;">
    <div style="background:#ffffff;border-radius:24px;overflow:hidden;box-shadow:0 25px 50px -12px rgba(15,23,42,0.1);">
      <div style="background:linear-gradient(135deg, #082f49 0%, #0f172a 100%);color:#ffffff;padding:40px 35px;">
        <p style="margin:0 0 10px;font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:#38bdf8;">Rappel Automatique J-{{reminderLeadDays}}</p>
        <h1 style="margin:0;font-size:32px;line-height:1.2;font-weight:900;">{{title}}</h1>
      </div>
      <div style="padding:40px 35px;">
        <p style="margin:0 0 20px;font-size:18px;font-weight:600;">Bonjour {{employeeName}},</p>
        <p style="margin:0 0 28px;line-height:1.7;color:#475569;font-size:16px;">
          Ceci est un rappel automatique pour votre tâche prévue dans exactement <strong>{{reminderLeadDays}} jours</strong>.
        </p>
        
        <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:20px;padding:28px;margin-bottom:32px;">
          <table style="width:100%;border-collapse:collapse;">
            <tr>
              <td style="padding-bottom:12px;color:#94a3b8;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;">Échéance</td>
              <td style="padding-bottom:12px;color:#94a3b8;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;">Lieu</td>
            </tr>
            <tr>
              <td style="padding-bottom:24px;font-weight:700;font-size:16px;">{{eventDate}} à {{eventTime}}</td>
              <td style="padding-bottom:24px;font-weight:700;font-size:16px;">{{location}}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding-bottom:12px;color:#94a3b8;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;">Description</td>
            </tr>
            <tr>
              <td colspan="2" style="line-height:1.6;color:#334155;">{{description}}</td>
            </tr>
          </table>
        </div>
        
        <div style="text-align:center;">
          <a href="{{agendaUrl}}" style="display:inline-block;background:#0f766e;color:#ffffff;text-decoration:none;border-radius:16px;padding:18px 32px;font-weight:800;font-size:16px;box-shadow:0 10px 15px -3px rgba(15,118,110,0.3);">Consulter l'Agenda</a>
        </div>
        
        <p style="margin:40px 0 0;padding-top:28px;border-top:1px solid #f1f5f9;font-size:14px;color:#94a3b8;text-align:center;">
          Cet email a été généré automatiquement par Explor'Île Agenda.
        </p>
      </div>
    </div>
  </div>
</div>
