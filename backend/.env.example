# Backend Configuration Example
# Copy this file to .env and fill in your values

# Server Port
PORT=5000

# Database Configuration
# If your host provides a single DATABASE_URL, use that instead of DB_* variables.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=your_database_url

DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_db_name

# Admin Credentials
ADMIN_USER=Tourisme
ADMIN_PASSWORD=2026

# JWT Secret (IMPORTANT: In production, use a long random string - minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-in-production-min-32-chars

# Public backend URL used for uploaded image URLs
PUBLIC_BACKEND_URL=http://localhost:5000

# Frontend origins allowed to call /api.
# For multiple origins, use CORS_ORIGINS=http://localhost:5173,https://example.com
FRONTEND_URL=http://localhost:5173

# Calendar reminder configuration
CALENDAR_REMINDER_HOURS=24
CALENDAR_REMINDER_INTERVAL_MS=3600000

# SMTP configuration for automatic employee reminders
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Agenda Pro <agenda@example.com>
